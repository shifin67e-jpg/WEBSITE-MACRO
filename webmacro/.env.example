# ---- Server -------------------------------------------------------------
# Railway sets PORT automatically. Keep these defaults for local runs.
PORT=3000
HOST=0.0.0.0

# ---- Streaming ----------------------------------------------------------
# Frames per second of the live Chromium canvas (~10 FPS spec target)
STREAM_FPS=10
# JPEG quality 1-100 (lower = smaller frames = smoother over mobile networks)
STREAM_QUALITY=55
# Default viewport preset: phone-sm | phone | phone-lg | tablet | laptop | desktop
DEFAULT_VIEWPORT=phone

# ---- Sessions -----------------------------------------------------------
# Hard cap on concurrent browser sessions (memory guard on small Railway plans)
MAX_SESSIONS=4
# Closing a socket does not kill the context immediately; idle contexts are reaped
SESSION_IDLE_MS=900000

# ---- Persistence --------------------------------------------------------
# Optional Railway volume mount for the saved macro library (best-effort JSON store)
DATA_DIR=/data
